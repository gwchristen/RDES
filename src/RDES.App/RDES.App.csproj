<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>RDES</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Configurations>Debug;Release;Client-Debug;Client-Release</Configurations>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <!-- Server / Host Build Configurations -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Release'">
    <AssemblyName>RDES-Server</AssemblyName>
    <DefineConstants>$(DefineConstants);RDES_HOST</DefineConstants>
  </PropertyGroup>

  <!-- Client / Workstation Lite Build Configurations -->
  <PropertyGroup Condition="'$(Configuration)' == 'Client-Debug' Or '$(Configuration)' == 'Client-Release'">
    <AssemblyName>RDES-Client</AssemblyName>
    <DefineConstants>$(DefineConstants);RDES_CLIENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

</Project>
