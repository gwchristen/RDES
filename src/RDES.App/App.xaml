<Application x:Class="RDES.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RDES.App.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
            <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisConverter"/>
            <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisConverter"/>
            <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
            <converters:IntEqualsToBooleanConverter x:Key="IntEqualsToBoolConverter"/>
            <converters:StringEqualsToBooleanConverter x:Key="StringEqualsToBoolConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
