<UserControl x:Class="RDES.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Shared DB Card -->
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/> <!-- Backup Card -->
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/> <!-- OpCo Management Card -->
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/> <!-- Defect Management Card -->
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/> <!-- System Info Card -->
            </Grid.RowDefinitions>

            <!-- Shared Network Database Configuration Card -->
            <Border Grid.Row="0" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Shared Network Database Configuration" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Multi-User SQLite with WAL Concurrency" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                   FontSize="12" 
                                   DockPanel.Dock="Right" 
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="Specify the path to the database file. For multi-user access across Windows 11 PCs, place this file on a shared network drive (e.g. \\Server\Shared\RDES_Data\rdes_shared.db or Z:\rdes_shared.db)." 
                               TextWrapping="Wrap" 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontSize="13" 
                               Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding DatabasePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="36" 
                                 FontSize="13"
                                 VerticalContentAlignment="Center"/>

                        <Button Grid.Column="2" 
                                Content="📁 Browse / Select..." 
                                Style="{StaticResource SecondaryButton}" 
                                Command="{Binding BrowseDatabasePathCommand}" 
                                Height="36" 
                                Padding="16,0"/>
                    </Grid>

                    <!-- Test Result Banner -->
                    <Border CornerRadius="6" 
                            Padding="12,10" 
                            Margin="0,0,0,14"
                            Visibility="{Binding TestResult, Converter={StaticResource StringNotEmptyToVisConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FEF2F2"/>
                                <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnectionSuccess}" Value="True">
                                        <Setter Property="Background" Value="#F0FDF4"/>
                                        <Setter Property="BorderBrush" Value="#86EFAC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding TestResult}" 
                                   FontWeight="SemiBold" 
                                   FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#991B1B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnectionSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="#166534"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Action buttons -->
                    <DockPanel>
                        <CheckBox Content="Automatically uppercase scanned serial numbers" 
                                  IsChecked="{Binding AutoUppercaseSerials}" 
                                  VerticalAlignment="Center" 
                                  FontWeight="Medium"/>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Content="⚡ Test Connection" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding TestConnectionCommand}" 
                                    Margin="0,0,10,0"/>
                            <Button Content="💾 Save &amp; Connect" 
                                    Style="{StaticResource PrimaryButton}" 
                                    Command="{Binding SaveSettingsCommand}" 
                                    MinWidth="140" 
                                    Height="36"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Database Backup & Snapshots Card -->
            <Border Grid.Row="2" Style="{StaticResource CardPanel}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" MaxWidth="600">
                        <TextBlock Text="Database Backup &amp; Snapshots" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Generate a safe point-in-time timestamped backup copy of the shared database while other users continue to work." 
                                   TextWrapping="Wrap" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                   FontSize="12"/>
                    </StackPanel>

                    <Button Content="📦 Backup Database Now..." 
                            Style="{StaticResource SecondaryButton}" 
                            Command="{Binding BackupDatabaseCommand}" 
                            DockPanel.Dock="Right" 
                            HorizontalAlignment="Right"
                            Height="36" 
                            Padding="16,0"/>
                </DockPanel>
            </Border>

            <!-- OpCo (Operating Company) Management Card -->
            <Border Grid.Row="4" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Operating Companies (OpCo) Management" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Configurable OpCos used across Data Entry &amp; Exports" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="Manage active OpCo options. You can add new OpCos or remove existing ones. Each OpCo can be individually filtered and exported." 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontSize="12" 
                               Margin="0,0,0,12"/>

                    <!-- Add New OpCo Form -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding NewOpCoName, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="36" 
                                 FontSize="13"
                                 VerticalContentAlignment="Center"/>

                        <Button Grid.Column="2" 
                                Content="➕ Add OpCo" 
                                Style="{StaticResource PrimaryButton}" 
                                Command="{Binding AddNewOpCoCommand}" 
                                Height="36" 
                                Padding="16,0"/>
                    </Grid>

                    <!-- Active OpCos List -->
                    <TextBlock Text="Current Active OpCos:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding OpCoList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#203B82F6" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="✕" 
                                                Foreground="#EF4444" 
                                                FontWeight="Bold" 
                                                FontSize="11" 
                                                Background="Transparent" 
                                                BorderThickness="0" 
                                                Cursor="Hand"
                                                ToolTip="Remove OpCo"
                                                Command="{Binding DataContext.DeleteOpCoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="2,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Defect Catalog Management Card -->
            <Border Grid.Row="6" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Defect / Problem Catalog" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Manage active defect options used across Data Entry &amp; Filters" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="Add new defect descriptions to the drop-down list in the Data Entry form or remove unwanted items." 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontSize="12" 
                               Margin="0,0,0,12"/>

                    <!-- Add New Defect Form -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding NewDefectName, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="36" 
                                 FontSize="13"
                                 VerticalContentAlignment="Center"/>

                        <Button Grid.Column="2" 
                                Content="➕ Add Defect" 
                                Style="{StaticResource PrimaryButton}" 
                                Command="{Binding AddNewDefectCommand}" 
                                Height="36" 
                                Padding="16,0"/>
                    </Grid>

                    <!-- Active Defects List -->
                    <TextBlock Text="Current Active Defects:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding DefectList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#203B82F6" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="✕" 
                                                Foreground="#EF4444" 
                                                FontWeight="Bold" 
                                                FontSize="11" 
                                                Background="Transparent" 
                                                BorderThickness="0" 
                                                Cursor="Hand"
                                                ToolTip="Remove Defect from list"
                                                Command="{Binding DataContext.DeleteDefectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="2,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- System Information & Audit Context Card -->
            <Border Grid.Row="8" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="Current Environment &amp; Audit Tracking" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Active Windows User:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding ActiveUserName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Machine Name:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding ActiveMachineName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Application Architecture:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text=".NET 8.0 WPF (Zero-Install Portable)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
