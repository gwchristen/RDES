<UserControl x:Class="RDES.App.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Filters & Date Range Card -->
                <RowDefinition Height="14"/>   <!-- Spacing -->
                <RowDefinition Height="Auto"/> <!-- Summary KPI Metrics Cards -->
                <RowDefinition Height="14"/>   <!-- Spacing -->
                <RowDefinition Height="Auto"/> <!-- Primary Pivot Table & Breakdown Matrix -->
                <RowDefinition Height="14"/>   <!-- Spacing -->
                <RowDefinition Height="Auto"/> <!-- Secondary 4-Card Breakdown Grid -->
                <RowDefinition Height="Auto"/> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Filters & Query Combinations Card -->
            <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header & Quick Date Filters -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="📊 Query &amp; Statistics Filter" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Combine any criteria to calculate exact quantities" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Quick Date Presets -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Presets: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Content="Today" Style="{StaticResource SecondaryButton}" Command="{Binding FilterTodayCommand}" Padding="8,4" FontSize="11" Margin="0,0,4,0"/>
                            <Button Content="Yesterday" Style="{StaticResource SecondaryButton}" Command="{Binding FilterYesterdayCommand}" Padding="8,4" FontSize="11" Margin="0,0,4,0"/>
                            <Button Content="This Week" Style="{StaticResource SecondaryButton}" Command="{Binding FilterThisWeekCommand}" Padding="8,4" FontSize="11" Margin="0,0,4,0"/>
                            <Button Content="This Month" Style="{StaticResource SecondaryButton}" Command="{Binding FilterThisMonthCommand}" Padding="8,4" FontSize="11" Margin="0,0,4,0"/>
                            <Button Content="All Time" Style="{StaticResource SecondaryButton}" Command="{Binding FilterAllTimeCommand}" Padding="8,4" FontSize="11"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Row 1: Filter Dropdowns Grid -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/> <!-- Date From -->
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1.2*"/> <!-- Date To -->
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.4*"/> <!-- OpCo -->
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.4*"/> <!-- Operator / User -->
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.6*"/> <!-- Defect / Issue -->
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.3*"/> <!-- Device Code -->
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.1*"/> <!-- Status -->
                        </Grid.ColumnDefinitions>

                        <!-- Date From -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="From Date" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Height="34"/>
                        </StackPanel>

                        <!-- Date To -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="To Date" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Height="34"/>
                        </StackPanel>

                        <!-- OpCo -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="OpCo" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding OpCoList}" SelectedItem="{Binding SelectedOpCo}" Height="34" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Operator / User -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Operator / User" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding UserList}" SelectedItem="{Binding SelectedUser}" Height="34"/>
                        </StackPanel>

                        <!-- Defect / Issue -->
                        <StackPanel Grid.Column="8">
                            <TextBlock Text="Defect / Issue" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding DefectList}" SelectedItem="{Binding SelectedDefect}" Height="34"/>
                        </StackPanel>

                        <!-- Device Code -->
                        <StackPanel Grid.Column="10">
                            <TextBlock Text="Device Code" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding DeviceCodeList}" SelectedItem="{Binding SelectedDeviceCode}" Height="34"/>
                        </StackPanel>

                        <!-- Status -->
                        <StackPanel Grid.Column="12">
                            <TextBlock Text="Status" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding StatusList}" SelectedItem="{Binding SelectedStatus}" Height="34"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Action Buttons -->
                    <DockPanel Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Reset Filters" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ResetFiltersCommand}" 
                                    Height="34" 
                                    Padding="14,0" 
                                    Margin="0,0,8,0"/>
                            <Button Content="🔄 Calculate Statistics" 
                                    Style="{StaticResource PrimaryButton}" 
                                    Command="{Binding RefreshStatisticsCommand}" 
                                    Height="34" 
                                    Padding="18,0"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- 2. KPI Summary Metrics Cards -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Matched -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="TOTAL MATCHED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalRecords}" FontSize="24" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="Devices in filter" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Pending Active -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="PENDING RMA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding PendingRecords}" FontSize="24" FontWeight="ExtraBold" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="Awaiting shipment" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Submitted -->
                <Border Grid.Column="4" Style="{StaticResource CardPanel}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="SUBMITTED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding SubmittedRecords}" FontSize="24" FontWeight="ExtraBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="Completed &amp; returned" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Unique Serials / Operators -->
                <Border Grid.Column="6" Style="{StaticResource CardPanel}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="ACTIVE OPERATORS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ActiveOperators}" FontSize="24" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding UniqueSerials, StringFormat='{}{0} unique serials'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Top Issue -->
                <Border Grid.Column="8" Style="{StaticResource CardPanel}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="TOP DEFECT / ISSUE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TopDefect}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" ToolTip="{Binding TopDefect}"/>
                        <TextBlock Text="{Binding TopDeviceCode, StringFormat='{}Top Code: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Primary Multi-Dimensional Pivot & Grouping Table Card -->
            <Border Grid.Row="4" Style="{StaticResource CardPanel}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header & Group-By Selector -->
                    <DockPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Group / Aggregate By:" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding GroupByOptions}" 
                                      SelectedItem="{Binding SelectedGroupBy}" 
                                      Height="34" 
                                      MinWidth="210"
                                      FontWeight="SemiBold"
                                      VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="📋 Copy Summary" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding CopySummaryToClipboardCommand}" 
                                    Padding="10,5" 
                                    Margin="0,0,8,0"
                                    ToolTip="Copy statistics breakdown to clipboard"/>
                            <Button Content="📊 Export Report (.csv)" 
                                    Style="{StaticResource SuccessButton}" 
                                    Command="{Binding ExportStatisticsExcelCommand}" 
                                    Padding="12,5"
                                    FontWeight="SemiBold"
                                    ToolTip="Export aggregated statistics to CSV/Excel"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Aggregated Results DataGrid -->
                    <DataGrid Grid.Row="2" 
                              ItemsSource="{Binding GroupedResults}" 
                              MaxHeight="380"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <!-- Primary Category -->
                            <DataGridTextColumn Header="Category" Binding="{Binding Key}" FontWeight="Bold" Width="220"/>
                            <!-- Sub Category (for multi-combinations e.g. OpCo + Defect) -->
                            <DataGridTextColumn Header="Secondary / Sub-Category" Binding="{Binding SubKey}" Width="220"/>
                            <!-- Quantity -->
                            <DataGridTextColumn Header="Quantity (Total)" Binding="{Binding Count}" FontWeight="ExtraBold" Width="140"/>
                            <!-- Percentage -->
                            <DataGridTextColumn Header="Share (%)" Binding="{Binding FormattedPercentage}" FontWeight="SemiBold" Width="100"/>
                            <!-- Visual Share Bar -->
                            <DataGridTemplateColumn Header="Distribution" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,0">
                                            <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="14" Foreground="{DynamicResource PrimaryBrush}" Background="#20808080" BorderThickness="0"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 4. Multi-Card Quick Breakdowns Grid -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- By OpCo -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Top Operating Companies" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding OpCoBreakdown}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Count, StringFormat='{}{0}'}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding Key}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- By Defect -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Top Defects / Issues" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding DefectBreakdown}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Count, StringFormat='{}{0}'}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding Key}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="{Binding Key}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- By Operator -->
                <Border Grid.Column="4" Style="{StaticResource CardPanel}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Top Operators" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding UserBreakdown}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Count, StringFormat='{}{0}'}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding Key}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- By Device Code -->
                <Border Grid.Column="6" Style="{StaticResource CardPanel}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Top Device Codes" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding DeviceCodeBreakdown}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Count, StringFormat='{}{0}'}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding Key}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Status Message Banner -->
            <TextBlock Grid.Row="7" 
                       Text="{Binding StatusMessage}" 
                       Foreground="{DynamicResource TextSecondaryBrush}" 
                       FontSize="12" 
                       Margin="4,10,0,0"/>
        </Grid>
    </ScrollViewer>
</UserControl>
