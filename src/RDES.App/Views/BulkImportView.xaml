<UserControl x:Class="RDES.App.Views.BulkImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Instructions / File Selector Card -->
            <RowDefinition Height="15"/>   <!-- Spacing -->
            <RowDefinition Height="*"/>    <!-- Preview Grid Card -->
            <RowDefinition Height="Auto"/> <!-- Status Banner -->
        </Grid.RowDefinitions>

        <!-- File Selector & Options Card -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Bulk Spreadsheet Import (.xlsm / .xlsx)" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Import RMA sheets, AEP records, or device spreadsheets into the shared database" 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontSize="12" 
                               DockPanel.Dock="Right" 
                               VerticalAlignment="Center"/>
                </DockPanel>

                <!-- File Picker Row with Target OpCo Selector -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                             Text="{Binding SelectedFilePath, Mode=TwoWay}" 
                             Height="36" 
                             FontSize="13" 
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"/>

                    <Button Grid.Column="2" 
                            Content="📁 Browse File..." 
                            Style="{StaticResource SecondaryButton}" 
                            Command="{Binding BrowseFileCommand}" 
                            Height="36" 
                            Padding="14,0"/>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Worksheet:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding AvailableSheets}" 
                                  SelectedItem="{Binding SelectedSheet}" 
                                  Height="32" 
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Target OpCo *:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding OpCoList}" 
                                  SelectedItem="{Binding SelectedOpCo}" 
                                  Height="32" 
                                  FontWeight="Bold"
                                  VerticalContentAlignment="Center"
                                  ToolTip="All imported records will be assigned to this Operating Company"/>
                    </StackPanel>
                </Grid>

                <!-- Actions and Options Row -->
                <DockPanel Grid.Row="2">
                    <CheckBox Content="Overwrite existing records if Serial Number already exists" 
                              IsChecked="{Binding OverwriteDuplicates}" 
                              VerticalAlignment="Center" 
                              FontWeight="Medium"/>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Content="🔍 Re-Parse Sheet" 
                                Style="{StaticResource SecondaryButton}" 
                                Command="{Binding ParseSpreadsheetCommand}" 
                                Margin="0,0,10,0"/>
                        <Button Content="📥 Import to Database" 
                                Style="{StaticResource SuccessButton}" 
                                Command="{Binding ExecuteImportCommand}" 
                                IsEnabled="{Binding HasParsedRecords}"
                                MinWidth="180" 
                                Height="36" 
                                FontSize="13"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Preview Grid Card -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="16,12">
                    <TextBlock Text="Data Preview" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PreviewCount, StringFormat='{}{0} record(s) parsed'}" 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontSize="12" 
                               DockPanel.Dock="Right" 
                               VerticalAlignment="Center"/>
                </DockPanel>

                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding PreviewRecords}" 
                          BorderThickness="0" 
                          MaxHeight="400">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="OpCo" Binding="{Binding OpCo}" FontWeight="SemiBold" Width="110"/>
                        <DataGridTextColumn Header="Serial #" Binding="{Binding SerialNumber}" FontWeight="Bold" Width="130"/>
                        <DataGridTextColumn Header="Module #" Binding="{Binding ModuleNumber}" Width="140"/>
                        <DataGridTextColumn Header="Defect / Problem" Binding="{Binding Defect}" Width="200"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                        <DataGridTextColumn Header="DEV CD" Binding="{Binding DeviceCode}" Width="85"/>
                        <DataGridTextColumn Header="MFR CD" Binding="{Binding ManufacturerCode}" Width="85"/>
                        <DataGridTextColumn Header="Catalog #" Binding="{Binding Catalog}" Width="110"/>
                        <DataGridTextColumn Header="Customer Input" Binding="{Binding CustomerInput}" Width="140"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Status Message Banner -->
        <Border Grid.Row="3" 
                Background="#EFF6FF" 
                BorderBrush="#BFDBFE" 
                BorderThickness="1" 
                CornerRadius="6" 
                Padding="12,10" 
                Margin="0,10,0,0"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisConverter}}">
            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="#1E40AF" 
                       FontWeight="Medium" 
                       FontSize="13"/>
        </Border>
    </Grid>
</UserControl>
